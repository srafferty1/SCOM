try {
    Import-Module OperationsManager -ErrorAction Stop
} catch {
    Write-Log "Could not load the OperationsManager module: $($_.Exception.Message)" 'ERROR'
    Write-AppEvent -EventId ((Get-EventBase) + 2) -EntryType 'Error' -Message "$(Get-RunMode): OperationsManager module failed to load: $($_.Exception.Message)"
    exit 1
}

# ==========================================================================
# CHANGE mode - scheduled change windows from the CMDB
# ==========================================================================
# Deliberately kept at arm's length from the shutdown side:
#   - its own state file, so tracked-state counting, TrackedCeiling and the
#     state-loss logic are untouched by it
#   - its own mutex, so a slow SQL query can never starve the APPLY loop
#   - it creates SCOM maintenance SCHEDULES, not maintenance mode: SCOM starts
#     them at DOWN_START and ends them at PLANNED_END with no help from us
#   - the windows it creates read as FOREIGN to Get-MaintenanceOwner, so the
#     sweep never extends or releases somebody's change window
#
# Windows are never extended. If a change overruns it is failed and re-raised,
# so a schedule that has already started is left exactly as it is.

$script:ChangeMap = $null

$ChangeQuery = @'
SELECT TOP (@MaxRows)
    c.NUMBER,
    c.BRIEF_DESCRIPTION,
    c.DOWN_START,
    c.PLANNED_END,
    (
        SELECT d.CI_NAME + ' ' AS 'data()'
        FROM DEVICE2M1 d
        WHERE d.CI_NAME LIKE @CiFilter
          AND CHARINDEX(d.LOGICAL_NAME, c.ASSETS, 1) <> 0
        FOR XML PATH('')
    ) AS CONFIG_ITEMS
FROM [dbo].[DOD_V_CHM_OVERVIEW] c
WHERE c.STATUS          <> 'closed'
  AND c.APPROVAL_STATUS  = 'approved'
  AND c.CI_DOWN          = 't'
  AND c.DOWN_START  IS NOT NULL
  AND c.PLANNED_END IS NOT NULL
  AND c.PLANNED_END > GETDATE()
  AND c.DOWN_START  < DATEADD(day, @LookAhead, GETDATE())
ORDER BY c.DOWN_START;
'@

function Get-ChangeWindowRows {
    if ([string]::IsNullOrWhiteSpace($ChangeStateFile)) { return @() }

    # ---- Recovery, mirroring Get-TrackedState -----------------------------
    # Set-ChangeWindowRows leaves the previous generation at .bak on every
    # successful write, and nothing read it back until now.
    #
    # Losing this file does not fail safe on its own. It is what tells the
    # shutdown side that a window is change-driven and hands-off; without it,
    # ownership falls back to the comment test, and CHANGE comments are written
    # WITHOUT $Marker precisely so they read as foreign. But that fallback only
    # works on an SDK build that surfaces window comments at all. Where it does
    # not, Get-MaintenanceOwner returns 'Unknown', every caller treats Unknown
    # as ours, and the sweep extends and releases somebody's change window.
    # Two independent failures are needed for that. One of them is cheap to
    # remove, so it is removed.
    #
    # The primary is not restored from the backup here - unlike the shutdown
    # state, the next CHANGE pass rewrites this file in full anyway.
    $rows = $null
    if (Test-Path $ChangeStateFile) {
        try { $rows = @(Import-Csv -Path $ChangeStateFile -ErrorAction Stop) }
        catch {
            Write-Log "Change window state at $ChangeStateFile could not be read: $($_.Exception.Message)" 'ERROR'
            $rows = $null
        }
    }

    if ($null -eq $rows) {
        $bak = "$ChangeStateFile.bak"
        if (Test-Path $bak) {
            try {
                $bakRows = @(Import-Csv -Path $bak -ErrorAction Stop)
                if ($bakRows.Count -gt 0) {
                    $rows = $bakRows
                    Write-Log "Change window state missing or unreadable - recovered $($bakRows.Count) row(s) from $bak." 'ERROR'
                    Add-EventRecord -Type 'ChangeStateRecovered' -Fqdn '' -Detail $bakRows.Count
                } else {
                    # An empty backup recovers nothing. Do not dress that up.
                    Write-Log "Backup change window state at $bak is empty; nothing to recover." 'WARN'
                }
            } catch {
                Write-Log "Backup change window state at $bak is also unreadable: $($_.Exception.Message)" 'ERROR'
            }
        }
    }

    # No file and no backup is the normal state before CHANGE has ever run.
    if ($null -eq $rows) { return @() }

    try {
        # Projected to a fixed shape, so an older file missing a column reads
        # back with that column empty instead of throwing when it is assigned.
        $out = New-Object System.Collections.Generic.List[object]
        foreach ($r in $rows) {
            if ([string]::IsNullOrWhiteSpace($r.InstanceId) -or [string]::IsNullOrWhiteSpace($r.EndUtc)) { continue }
            $props = $r.PSObject.Properties
            $out.Add([pscustomobject]@{
                ChangeNumber    = [string]$r.ChangeNumber
                ScheduleName    = [string]$r.ScheduleName
                Fqdn            = [string]$r.Fqdn
                InstanceId      = [string]$r.InstanceId
                StartUtc        = [string]$r.StartUtc
                EndUtc          = [string]$r.EndUtc
                WrittenUtc      = $(if ($props['WrittenUtc'])      { [string]$r.WrittenUtc }      else { '' })
                MissingSinceUtc = $(if ($props['MissingSinceUtc']) { [string]$r.MissingSinceUtc } else { '' })
            })
        }
        return $out.ToArray()
    } catch {
        # Never fatal for the shutdown side. A change file that cannot be
        # projected must not stop a sweep; it only means ownership falls back
        # to the comment test.
        Write-Log "Change window state could not be projected into rows: $($_.Exception.Message)" 'ERROR'
        return @()
    }
}

function Set-ChangeWindowRows {
    param($Rows)
    if ($DryRun) { Write-Verbose 'DRYRUN: change window state not written.'; return }
    New-ParentDirectory -Path $ChangeStateFile
    $header = 'ChangeNumber,ScheduleName,Fqdn,InstanceId,StartUtc,EndUtc,WrittenUtc,MissingSinceUtc'
    $tmp    = "$ChangeStateFile.tmp"
    $arr    = @($Rows)
    if ($arr.Count -gt 0) {
        $arr | Select-Object ChangeNumber, ScheduleName, Fqdn, InstanceId, StartUtc, EndUtc, WrittenUtc, MissingSinceUtc |
            Export-Csv -Path $tmp -NoTypeInformation -Force
    } else {
        Set-Content -Path $tmp -Value $header -Force
    }
    if (Test-Path $ChangeStateFile) {
        try { [System.IO.File]::Replace($tmp, $ChangeStateFile, "$ChangeStateFile.bak", $true) }
        catch {
            # Same fallback as Set-TrackedState: keep the backup generation.
            Write-Log "Change state swap failed ($($_.Exception.Message)); falling back to copy-then-move." 'WARN'
            try { Copy-Item -Path $ChangeStateFile -Destination "$ChangeStateFile.bak" -Force -ErrorAction Stop }
            catch { Write-Log "Could not refresh ${ChangeStateFile}.bak: $($_.Exception.Message)" 'WARN' }
            Move-Item -Path $tmp -Destination $ChangeStateFile -Force
        }
    } else {
        Move-Item -Path $tmp -Destination $ChangeStateFile -Force
    }
}

# InstanceId -> end of the change window the machine is inside RIGHT NOW.
# Built once per invocation. Small by construction: it only ever holds machines
# named by open changes, never the estate.
function Get-ChangeMap {
    if ($null -ne $script:ChangeMap) { return $script:ChangeMap }
    $map = @{}
    $now = [datetime]::UtcNow
    foreach ($r in (Get-ChangeWindowRows)) {
        $start = ConvertTo-Utc $r.StartUtc
        $end   = ConvertTo-Utc $r.EndUtc
        if ($null -eq $end) { continue }
        if ($end.AddMinutes($ChangeWindowGraceMinutes) -lt $now) { continue }                        # finished
        if ($null -ne $start -and $start.AddMinutes(-$ChangeWindowGraceMinutes) -gt $now) { continue } # not started
        $k = [string]$r.InstanceId
        if (-not $map.ContainsKey($k) -or $map[$k] -lt $end) { $map[$k] = $end }
    }
    $script:ChangeMap = $map
    if ($map.Count -gt 0) { Write-Log "$($map.Count) machine(s) are inside a scheduled change window and are hands-off." }
    return $script:ChangeMap
}

function Test-ChangeWindow {
    param($InstanceId)
    if (-not $InstanceId) { return $false }
    return (Get-ChangeMap).ContainsKey([string]$InstanceId)
}

# Schedule names have to be unique per change, and stripping unsafe characters
# alone can collide: 'CHM-123/45' and 'CHM-12345' both reduce to CHM-12345, and
# the second change would silently amend the first one's window. Anything that
# had to be altered therefore carries a short deterministic hash of the
# ORIGINAL number. Untouched numbers - the normal case - keep their plain name.
function New-ChangeScheduleName {
    param([Parameter(Mandatory)][string]$Number)
    $safe = (($Number -replace '[^A-Za-z0-9\-_]', '-') -replace '-{2,}', '-').Trim('-')
    if ($safe -cne $Number) {
        $sha = [System.Security.Cryptography.SHA256]::Create()
        try { $bytes = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($Number)) }
        finally { $sha.Dispose() }
        $safe = '{0}-{1}{2}' -f $safe, $bytes[0].ToString('x2'), $bytes[1].ToString('x2')
    }
    return $ChangeSchedulePrefix + $safe
}

# --------------------------------------------------------------------------
function Invoke-ChangePass {
    $created = 0; $amended = 0; $removed = 0; $unchanged = 0

    # First, so an unreadable exclusion file stops the pass before anything moves.
    $exclusions = @(Get-ExclusionList)

    # ---- read the approved changes ----------------------------------------
    $table = $null
    $connection = $null
    try {
        $connection = New-Object System.Data.SqlClient.SqlConnection
        $connection.ConnectionString = "Server=$ChangeSqlServer;Database=$ChangeDatabase;Integrated Security=True;Connect Timeout=15;Application Name=ScomChangeMM"
        $connection.Open()
        $cmd = $connection.CreateCommand()
        $cmd.CommandText    = $ChangeQuery
        $cmd.CommandTimeout = 60
        [void]$cmd.Parameters.AddWithValue('@MaxRows',   $ChangeMaxRows)
        [void]$cmd.Parameters.AddWithValue('@CiFilter',  "%$ChangeCiFilter%")
        [void]$cmd.Parameters.AddWithValue('@LookAhead', $ChangeLookAheadDays)
        $reader = $cmd.ExecuteReader()
        $table  = New-Object System.Data.DataTable
        try { $table.Load($reader) } finally { $reader.Dispose() }
    } catch {
        $msg = "Change query against [$ChangeSqlServer].[$ChangeDatabase] failed: $($_.Exception.Message)"
        Write-Log $msg 'ERROR'
        Send-Notification -Key 'ChangeQueryFailure' -Severity 'ERROR' `
            -Subject 'Change maintenance windows are not being scheduled' `
            -Body ($msg + "`r`n`r`nApproved changes will not have maintenance windows created while this persists.") `
            -MinIntervalMinutes 120
        return
    } finally {
        if ($null -ne $connection) { $connection.Dispose() }
    }

    $changes = New-Object System.Collections.Generic.List[object]
    foreach ($row in $table.Rows) {
        $cis = ''
        if (-not [System.DBNull]::Value.Equals($row['CONFIG_ITEMS'])) { $cis = [string]$row['CONFIG_ITEMS'] }
        if ([string]::IsNullOrWhiteSpace($cis)) { continue }        # no CIs matched the filter
        $changes.Add([pscustomobject]@{
            Number      = ([string]$row['NUMBER']).Trim()
            Description = [string]$row['BRIEF_DESCRIPTION']
            DownStart   = [datetime]$row['DOWN_START']
            PlannedEnd  = [datetime]$row['PLANNED_END']
            Cis         = @($cis -split '\s+' | Where-Object { $_ } | Select-Object -Unique)
        })
    }
    Write-Log "Change query returned $($table.Rows.Count) row(s); $($changes.Count) carry CIs."

    # ---- what SCOM already has --------------------------------------------
    # Also the rights check: reading schedules needs the same admin role that
    # creating them does, so a permissions problem surfaces here, once, plainly.
    $existing = @{}
    try {
        foreach ($sch in @(Get-SCOMMaintenanceSchedule -ErrorAction Stop)) {
            if ($sch.ScheduleName) { $existing[[string]$sch.ScheduleName] = $sch }
        }
    } catch {
        $msg = "Cannot read SCOM maintenance schedules: $($_.Exception.Message)"
        Write-Log ($msg + ' The account running this needs the Operations Manager Administrator role.') 'ERROR'
        Send-Notification -Key 'ChangeScheduleAccess' -Severity 'ERROR' `
            -Subject 'Change maintenance windows cannot be scheduled' `
            -Body ($msg + "`r`n`r`nMaintenance schedules require the Operations Manager Administrator role. Approved changes are not being suppressed.") `
            -MinIntervalMinutes 720
        return
    }

    # ---- resolve every CI in one batched lookup ---------------------------
    $names = New-Object System.Collections.Generic.List[string]
    foreach ($c in $changes) {
        foreach ($ci in $c.Cis) {
            [void]$names.Add($ci)
            if ($ChangeDomainSuffix -and $ci -notlike '*.*') { [void]$names.Add("$ci.$ChangeDomainSuffix") }
        }
    }
    $cmap = @{}
    if ($names.Count -gt 0) { $cmap = Get-WindowsComputerMap -Fqdns $names.ToArray() }

    # ---- carry forward windows that are still live ------------------------
    # A change that closes after its window has started stops coming back from
    # the query, but SCOM is still running the window. Dropping the row here
    # would hand the machine back to the shutdown side mid-outage.
    $nowUtc = [datetime]::UtcNow
    $keep   = @{}
    foreach ($r in (Get-ChangeWindowRows)) {
        $end = ConvertTo-Utc $r.EndUtc
        if ($null -eq $end -or $end.AddMinutes($ChangeWindowGraceMinutes) -lt $nowUtc) { continue }
        $keep["$($r.ChangeNumber)|$($r.InstanceId)"] = $r
    }

    $seen = New-Object System.Collections.Generic.HashSet[string]

    foreach ($chg in $changes) {
        $name = New-ChangeScheduleName -Number $chg.Number
        [void]$seen.Add($name)

        $instances = New-Object System.Collections.Generic.List[object]
        $excludedHere = 0
        foreach ($ci in $chg.Cis) {
            $inst = $cmap[$ci]
            if (-not $inst -and $ChangeDomainSuffix -and $ci -notlike '*.*') { $inst = $cmap["$ci.$ChangeDomainSuffix"] }
            if (-not $inst) { Write-Log "$($chg.Number): CI not found in SCOM -> $ci" 'WARN'; continue }

            $hit = Get-ExclusionMatch -Fqdn $inst.DisplayName -Exclusions $exclusions
            if ($hit) {
                Write-Log "$($chg.Number): $($inst.DisplayName) is on the exclusion list ('$hit') - left out of the change window." 'WARN'
                $excludedHere++
                continue
            }
            $instances.Add($inst)
        }
        if ($instances.Count -eq 0) {
            Write-Log "$($chg.Number): no CIs resolved$(if ($excludedHere) { ' (or all excluded)' }); no window scheduled." 'WARN'
            continue
        }

        # The CI set is part of what "unchanged" means. Comparing start and
        # duration alone left a window covering the OLD set whenever a change
        # gained or lost a CI - or a CI was added to the exclusion list. The
        # last pass's state rows are the record of what the window was given.
        $curIds  = @($instances | ForEach-Object { [string]$_.Id } | Sort-Object -Unique)
        $prevIds = @($keep.Values | Where-Object { $_.ChangeNumber -eq $chg.Number } |
                     ForEach-Object { [string]$_.InstanceId } | Sort-Object -Unique)
        $sameCis = ($prevIds.Count -eq 0) -or (-not (Compare-Object -ReferenceObject $prevIds -DifferenceObject $curIds))

        # A schedule cannot start in the past. An outage already under way starts
        # now and still ends at PLANNED_END.
        $start = if ($chg.DownStart -gt (Get-Date)) { $chg.DownStart } else { (Get-Date).AddMinutes(2) }
        $mins  = [int][Math]::Ceiling(($chg.PlannedEnd - $start).TotalMinutes)
        if ($mins -lt $ChangeMinDurationMinutes) { $mins = $ChangeMinDurationMinutes }
        if ($mins -gt ($ChangeMaxDurationHours * 60)) {
            Write-Log "$($chg.Number): window of $mins min exceeds the $ChangeMaxDurationHours h cap; capped." 'WARN'
            $mins = $ChangeMaxDurationHours * 60
        }

        # Deliberately WITHOUT $Marker. The change state file is what makes these
        # windows hands-off; if it is ever lost, the comment test is the fallback
        # and it must read foreign, not ours.
        $comment = "$($chg.Number) - $($chg.Description)" -replace '[\r\n]+', ' '
        if ($comment.Length -gt 250) { $comment = $comment.Substring(0, 250) }
        $ids = [guid[]]@($instances | ForEach-Object { $_.Id })

        $action = 'CREATE'
        if ($existing.ContainsKey($name)) {
            $sch = $existing[$name]
            # Never touch a window that has already started. Changes are not
            # extended here: an overrunning change is failed, not re-planned.
            if ([datetime]$sch.ActiveStartTime -le (Get-Date)) {
                Write-Log "$($chg.Number): window [$name] has already started; left as it is."
                if ($excludedHere) {
                    Write-Log "$($chg.Number): window [$name] is running and may still hold $excludedHere excluded machine(s) - end their maintenance mode by hand if so." 'WARN'
                }
                $action = 'RUNNING'
            }
            elseif (([Math]::Abs(((([datetime]$sch.ActiveStartTime) - $start).TotalSeconds)) -lt 60) -and
                    ([int]$sch.Duration -eq $mins) -and $sameCis) {
                $action = 'UNCHANGED'
            }
            else { $action = 'AMEND' }
        }

        if ($DryRun) {
            Write-Plan $action $name ("{0} for {1} min over {2} CI(s)" -f $start, $mins, $instances.Count)
        }
        else {
            try {
                switch ($action) {
                    'CREATE' {
                        New-SCOMMaintenanceSchedule -Name $name -MonitoringObjects $ids `
                            -ActiveStartTime $start -Duration $mins -ReasonCode PlannedOther `
                            -Comments $comment -Recursive -FreqType 1 -TimeZoneId $ChangeTimeZoneId | Out-Null
                        $created++
                        Write-Log "$($chg.Number): window [$name] created -> $start for $mins min over $($instances.Count) CI(s)."
                    }
                    'AMEND' {
                        Set-SCOMMaintenanceSchedule -ScheduleId $existing[$name].ScheduleId `
                            -MonitoringObjects $ids -ActiveStartTime $start -Duration $mins `
                            -ReasonCode PlannedOther -Comments $comment -Recursive
                        $amended++
                        Write-Log "$($chg.Number): window [$name] amended -> $start for $mins min over $($instances.Count) CI(s)."
                    }
                    default { $unchanged++ }
                }
            } catch {
                Write-Log "$($chg.Number): could not $action window [$name]: $($_.Exception.Message)" 'ERROR'
                continue
            }
        }

        # A window that was just created or amended no longer covers CIs that
        # have left the change, so their rows go too - otherwise the shutdown
        # side would keep treating those machines as hands-off until the old
        # end time. A RUNNING window was not touched, so its rows stay.
        if ($action -ne 'RUNNING') {
            foreach ($k in @($keep.Keys | Where-Object {
                        $keep[$_].ChangeNumber -eq $chg.Number -and $curIds -notcontains [string]$keep[$_].InstanceId })) {
                $keep.Remove($k)
            }
        }

        # A RUNNING window was not touched, so the rows already held for it are
        # the record of what it actually covers - leave them exactly as they
        # are. Rewriting them from the CURRENT CI list used to mark servers added
        # to the change after it started as hands-off, though SCOM never put them
        # in the window; and it re-stamped the start as now+2min every pass,
        # which with ChangeWindowGraceMinutes under 2 made a running window look
        # as if it had not started, so nothing in it was hands-off at all.
        if ($action -eq 'RUNNING') {
            $held = @($keep.Values | Where-Object { $_.ChangeNumber -eq $chg.Number })
            if ($held.Count -gt 0) {
                foreach ($r in $held) { $r.MissingSinceUtc = '' }   # it IS in the query this pass
                continue
            }
            # No record at all - state lost, or first run with this window
            # already going. Best effort: today's CI list, but the schedule's
            # OWN start and duration rather than recomputed ones.
            $start = [datetime]$existing[$name].ActiveStartTime
            $mins  = [int]$existing[$name].Duration
            Write-Log "$($chg.Number): window [$name] is running with no state held for it; recorded from the schedule's own times." 'WARN'
        }

        # State rows: what the shutdown side reads to know these are hands-off.
        foreach ($inst in $instances) {
            $keep["$($chg.Number)|$($inst.Id)"] = [pscustomobject]@{
                ChangeNumber = $chg.Number
                ScheduleName = $name
                Fqdn         = $inst.DisplayName
                InstanceId   = [string]$inst.Id
                StartUtc     = $start.ToUniversalTime().ToString('o')
                EndUtc       = $start.AddMinutes($mins).ToUniversalTime().ToString('o')
                WrittenUtc   = $nowUtc.ToString('o')
                MissingSinceUtc = ''      # present in the query this pass
            }
        }
    }

    # ---- withdraw schedules for changes that are gone ---------------------
    if ($ChangeReconcile) {
        foreach ($sch in $existing.Values) {
            $sname = [string]$sch.ScheduleName
            if ($sname -notlike "$ChangeSchedulePrefix*") { continue }        # not ours
            if ($seen.Contains($sname)) { continue }
            if ([datetime]$sch.ActiveStartTime -le (Get-Date)) { continue }   # running; leave it

            # Only ever withdraw a window this script holds state for. A window
            # matching the prefix that we have no record of belongs to someone
            # else, or to a deployment whose state file is gone - either way,
            # deleting it is not ours to do.
            $mine = @($keep.Values | Where-Object { $_.ScheduleName -eq $sname })
            if ($mine.Count -eq 0) {
                Write-Log "Window [$sname] matches the prefix but this script holds no record of it - left alone." 'WARN'
                continue
            }

            # NEVER withdraw on the strength of one absent observation. A failed
            # query already returned long before here, but data lag and approval
            # state transitions can also drop a live change for a pass or two.
            $since = ConvertTo-Utc ([string]$mine[0].MissingSinceUtc)
            if ($null -eq $since) {
                foreach ($m in $mine) { $m.MissingSinceUtc = $nowUtc.ToString('o') }
                Write-Log "Change behind window [$sname] was not returned this pass; watching it for $ChangeWithdrawAfterMinutes min before withdrawing."
                continue
            }
            $missingFor = ($nowUtc - $since).TotalMinutes
            if ($missingFor -lt $ChangeWithdrawAfterMinutes) {
                Write-Log ("Change behind window [$sname] still missing after {0:N0} min; will withdraw at {1} min." -f $missingFor, $ChangeWithdrawAfterMinutes)
                continue
            }

            if ($DryRun) { Write-Plan 'WITHDRAW' $sname ("missing for {0:N0} min" -f $missingFor); continue }
            try {
                Remove-SCOMMaintenanceSchedule -ScheduleId $sch.ScheduleId
                $removed++
                Write-Log ("Window [$sname] withdrawn - the change has not been approved and open for {0:N0} min." -f $missingFor) 'WARN'
                foreach ($k in @($keep.Keys | Where-Object { $keep[$_].ScheduleName -eq $sname })) { $keep.Remove($k) }
            } catch {
                Write-Log "Could not withdraw window [$sname]: $($_.Exception.Message)" 'ERROR'
            }
        }
    }

    Set-ChangeWindowRows -Rows @($keep.Values)
    $script:ChangeMap = $null      # rebuilt on next read

    $script:Stats.ChgCreated += $created
    $script:Stats.ChgAmended += $amended
    $script:Stats.ChgRemoved += $removed
    Write-Log ("CHANGE pass: {0} created, {1} amended, {2} withdrawn, {3} unchanged, {4} machine(s) under a change window." -f
               $created, $amended, $removed, $unchanged, $keep.Count)
}

function Test-MgConnection {
    try {
        return (@(Get-SCOMManagementGroupConnection -ErrorAction Stop |
                  Where-Object { $_.IsActive }).Count -gt 0)
    } catch { return $false }
}

function Connect-Mg {
    param([int]$Attempts = 2)
    for ($a = 1; $a -le $Attempts; $a++) {
        foreach ($ms in $ManagementServer) {
            try {
                New-SCOMManagementGroupConnection -ComputerName $ms -ErrorAction Stop
                if ($a -gt 1 -or $ms -ne $ManagementServer[0]) {
                    Write-Log "Connected to the management group via '$ms'." 'WARN'
                }
                return $true
            } catch {
                Write-Log "Connect to '$ms' failed (attempt $a): $($_.Exception.Message)" 'WARN'
            }
        }
        if ($a -lt $Attempts) { Start-Sleep -Seconds 5 }
    }
    return $false
}

# One iteration, holding the mutex ONLY for the duration of the work.
#
# The mutex used to be held for the life of the process. Under the loop that
# would mean APPLY holding it for four unbroken minutes, so SWEEP could never
# win it inside its timeout - the sweep would stop running entirely and nothing
# would ever be released. It must be per-iteration.
function Invoke-Pass {
    # CHANGE mode touches neither the tracked state file nor maintenance mode,
    # so it takes its OWN mutex. Sharing the shutdown one would let a slow SQL
    # query hold the lock the APPLY loop needs every 60 seconds.
    $mutexName = if ($Change) { 'Global\ScomChangeMaintenance' } else { 'Global\ScomShutdownMaintenanceMode' }
    $mutex = New-Object System.Threading.Mutex($false, $mutexName)
    $held  = $false
    try {
        try {
            $held = $mutex.WaitOne([timespan]::FromSeconds($LockTimeoutSeconds))
        } catch [System.Threading.AbandonedMutexException] {
            $held = $true      # previous holder died mid-pass; we own it now
            Write-Log 'Previous run appears to have died holding the lock.' 'WARN'
        }

        if (-not $held) {
            # Under the loop this is cheap - the next attempt is one interval
            # away, not one task launch away. COUNTED, because an invocation in
            # which every iteration skipped completed no passes, and that must
            # not be reported as the same failure as one that could not work.
            $script:LockSkips++
            Write-Log "Another pass holds the lock after $LockTimeoutSeconds seconds - skipping this iteration." 'WARN'
            return
        }

        if     ($Sweep)  { Invoke-SweepPass }
        elseif ($Digest) { Invoke-DigestPass }
        elseif ($Change) { Invoke-ChangePass }
        else             { Invoke-ApplyPass }

        $script:Stats.Passes++

    } catch {
        $err = $_
        Write-Log "Pass failed: $($err.Exception.Message)" 'ERROR'

        # Diagnostics for the 'Argument types do not match' failure. Logged at
        # WARN deliberately: Write-Log increments $script:Errs on ERROR, and the
        # closing watchdog event reports that count. One fault stays one error.
        try {
            $at    = ($err.InvocationInfo.PositionMessage -split "`r?`n" | ForEach-Object { $_.Trim() }) -join ' | '
            $stack = ($err.ScriptStackTrace               -split "`r?`n" | ForEach-Object { $_.Trim() }) -join ' | '
            Write-Log ("Pass failed [type] : {0}" -f $err.Exception.GetType().FullName) 'WARN'
            Write-Log ("Pass failed [at]   : {0}" -f $at)    'WARN'
            Write-Log ("Pass failed [stack]: {0}" -f $stack) 'WARN'
            if ($err.Exception.InnerException) {
                Write-Log ("Pass failed [inner]: {0}: {1}" -f
                           $err.Exception.InnerException.GetType().FullName,
                           $err.Exception.InnerException.Message) 'WARN'
            }
        } catch {
            Write-Log "Could not capture pass failure diagnostics: $($_.Exception.Message)" 'WARN'
        }
    } finally {
        if ($held) { try { $mutex.ReleaseMutex() } catch { } }
        try { $mutex.Dispose() } catch { }
    }
}

$mode = Get-RunMode

if ($DryRun) {
    $banner = "DRY RUN - $mode. SCOM is queried and agents are probed, but nothing is changed: no maintenance mode, no alert updates, no state files, no mail, and no watchdog event."
    Write-Output $banner
    Write-Output ''
    Write-Log $banner 'WARN'
}

if (-not (Connect-Mg)) {
    $msg = "Could not connect to the management group on any of: $($ManagementServer -join ', ')"
    Write-Log $msg 'ERROR'
    Write-AppEvent -EventId ((Get-EventBase) + 2) -EntryType 'Error' -Message "${mode}: $msg"

    # Worth an email: the script is doing nothing at all, and if SCOM itself is
    # the thing that is down, a SCOM alert will not reach anyone either.
    Send-Notification -Key 'ConnectFailure' -Severity 'ERROR' `
        -Subject 'Cannot connect to the management group' `
        -Body ($msg + "`r`n`r`nNo suppression is happening while this persists. Gracefully shut down machines will alert normally.") `
        -MinIntervalMinutes 60
    exit 1
}

$startedUtc = [datetime]::UtcNow
$iteration  = 0

while ($true) {
    $passStart = [datetime]::UtcNow

    if (-not (Test-MgConnection)) {
        Write-Log 'Management group connection is no longer active - reconnecting.' 'WARN'
        if (-not (Connect-Mg)) {
            Write-Log 'Reconnect failed - ending this invocation; the task will start a fresh one.' 'ERROR'
            break
        }
    }

    Invoke-Pass

    $elapsed = ([datetime]::UtcNow - $passStart).TotalSeconds
    Write-Log ('{0} pass {1} finished in {2:N1}s.' -f $mode, ($iteration + 1), $elapsed)

    if ($LoopIntervalSeconds -le 0) { break }   # single-pass mode

    # Anchor iterations to fixed offsets from the start, so a slow pass does not
    # drift the whole schedule. A pass that overran its slot skips the boundary
    # it missed rather than running back to back.
    $iteration++
    $target = $startedUtc.AddSeconds($iteration * $LoopIntervalSeconds)
    while ($target -lt [datetime]::UtcNow) {
        Write-Log ('Pass took {0:N1}s, longer than the {1}s slot - skipping an iteration.' -f
                   $elapsed, $LoopIntervalSeconds) 'WARN'
        $iteration++
        $target = $startedUtc.AddSeconds($iteration * $LoopIntervalSeconds)
    }

    if (($target - $startedUtc).TotalSeconds -gt $LoopBudgetSeconds) { break }

    # Do not start an iteration we do not expect to FINISH inside the window.
    # The budget alone only stops us starting past it: a 200-second pass
    # beginning at T+240 would run to T+440 and overrun the next task launch,
    # which "do not start a new instance" would then silently suppress. The
    # previous pass duration is the only estimate available, so use it.
    $projectedEnd = ($target - $startedUtc).TotalSeconds + $elapsed
    if ($projectedEnd -gt ($LoopBudgetSeconds + $LoopIntervalSeconds)) {
        Write-Log ('Ending this invocation early: the last pass took {0:N1}s, so another would finish around {1:N0}s and run past the next scheduled launch.' -f
                   $elapsed, $projectedEnd) 'WARN'
        break
    }

    $sleepMs = [int][Math]::Max(0, ($target - [datetime]::UtcNow).TotalMilliseconds)
    if ($sleepMs -gt 0) { Start-Sleep -Milliseconds $sleepMs }
}

$totalSeconds = ([datetime]::UtcNow - $startedUtc).TotalSeconds
$summary = @(
    "$mode invocation complete."
    ("Passes     : {0}" -f $script:Stats.Passes)
    ("Duration   : {0:N1}s" -f $totalSeconds)
    ("Tracked    : {0}" -f $script:Stats.Tracked)
    ("Applied    : {0}" -f $script:Stats.Applied)
    ("Released   : {0}" -f $script:Stats.Released)
    ("Extended   : {0}" -f $script:Stats.Extended)
    ("Reapplied  : {0}" -f $script:Stats.Reapplied)
    ("MM failures: {0}" -f $script:Stats.MmFailures)
    ("Orphans    : {0}" -f $script:Stats.Orphans)
    ("Lock skips : {0}" -f $script:LockSkips)
    ("Ping-only  : {0}" -f $script:Stats.PingOnly)
    ("Excluded   : {0}" -f $script:Stats.Excluded)
    ("Errors     : {0}" -f $script:Errs)
) -join "`r`n"

if ($Change) {
    $summary += "`r`n" + (@(
        ("Chg created: {0}" -f $script:Stats.ChgCreated)
        ("Chg amended: {0}" -f $script:Stats.ChgAmended)
        ("Chg removed: {0}" -f $script:Stats.ChgRemoved)
    ) -join "`r`n")
}

Write-Log ("{0} invocation complete: {1} pass(es) in {2:N1}s, {3} tracked, {4} error(s)." -f
           $mode, $script:Stats.Passes, $totalSeconds, $script:Stats.Tracked, $script:Errs)

if ($DryRun) {
    Write-Output ''
    Write-Output "DRY RUN complete - nothing was changed. $($script:Errs) error(s); see $LogPath."
    # Deliberately no watchdog event: the Missing Event monitor fires on their
    # absence, and a dry run has not done the work that event attests to.
    exit 0
}

# THE watchdog signal - see WATCHDOG EVENTS in the header. A Missing Event
# monitor on x100 OR x101 is the one failure email can never report, because a
# script that has stopped cannot send it.
$outcome = Get-RunOutcome -Passes $script:Stats.Passes -Errors $script:Errs -LockSkips $script:LockSkips
if ($outcome.ExitCode -eq 1) {
    Write-Log "No pass completed this invocation - reported as did-no-work (event $($outcome.EventId))." 'ERROR'
    $summary = "$mode did NO work: no pass completed and the lock was never contended, so every pass failed or the mode could not start. See $LogPath.`r`n`r`n" + $summary
} elseif ($script:Stats.Passes -le 0) {
    Write-Log ("No pass completed: all {0} iteration(s) deferred to another pass holding the lock. Reported as a warning, not did-no-work." -f $script:LockSkips) 'WARN'
    $summary = "$mode completed no pass: every iteration ($($script:LockSkips)) deferred to another pass holding the lock. The script is running; the task holding the lock is slow. See $LogPath.`r`n`r`n" + $summary
} elseif ($outcome.ExitCode -eq 2) {
    Write-Log "$($script:Errs) error(s) this invocation." 'WARN'
}
Write-AppEvent -EventId $outcome.EventId -EntryType $outcome.EntryType -Message $summary
exit $outcome.ExitCode
